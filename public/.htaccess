<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to .well-known
  RewriteRule ^\.well-known/ - [L]

  # Do not rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA entry point
  RewriteRule ^index\.html$ - [L]
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # RFC 8288 Link header on homepage
  <Files "index.html">
    Header set Link "</llms.txt>; rel=\"alternate\"; type=\"text/markdown\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </.well-known/mcp/server-card.json>; rel=\"service-desc\"; type=\"application/json\""
  </Files>
</IfModule>
